# Configuración del despliegue con Docker Compose (ver DEPLOY.md).
#
# Lo normal es NO editar esto a mano: corre ./deploy/generar-secretos.sh y crea
# el archivo .env con las dos claves al azar. Solo hace falta revisar SITE_ADDRESS
# y PUBLIC_URL. El .env real nunca se sube al repositorio (ya está en .gitignore).

# Contraseña de la base de datos. Solo letras y números (va dentro de una URL).
POSTGRES_PASSWORD=

# Llave con la que se firman las sesiones. Mínimo 32 caracteres, al azar. Si
# alguien la conoce puede fabricar una sesión de Administrador.
JWT_SECRET=

# Cómo se sirve el sitio:
#   :80                          HTTP simple (red interna, pruebas)
#   panteones.midominio.gob.mx   HTTPS automático (requiere dominio propio y
#                                los puertos 80 y 443 abiertos hacia internet)
SITE_ADDRESS=:80

# Dirección pública completa del sitio, tal como la escribirá la gente en el
# navegador. Debe coincidir con SITE_ADDRESS: http://IP-o-nombre, o https://dominio
PUBLIC_URL=http://localhost

# Solo si el puerto 80 / 443 del servidor ya lo usa otro servicio:
# HTTP_PORT=8080
# HTTPS_PORT=8443
