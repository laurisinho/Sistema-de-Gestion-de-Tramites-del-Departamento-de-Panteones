# Copiar a .env y ajustar antes de correr el backend.
# Nunca commitear el .env real (ya está en .gitignore).

## Local (Postgres propio) ##
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/panteones_municipales?schema=public"

## Supabase ##
# Dashboard del proyecto -> Connect (botón arriba) -> pestaña "ORMs" -> Prisma
# te da estas dos URLs ya armadas, solo pega tu password real donde dice
# [YOUR-PASSWORD]. NO pegues estas URLs completas en el chat: contienen tu
# contraseña de base de datos, solo van en este archivo local.

# DATABASE_URL: "Transaction pooler" (puerto 6543) -- la usa la app en cada query
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: "Direct connection" o "Session pooler" (puerto 5432) -- solo la usa
# `prisma migrate` para crear/alterar tablas, nunca la app en tiempo de ejecución
DIRECT_URL="postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# Este archivo es público (vive en el repo). El valor de abajo es solo un
# ejemplo -- si lo usas tal cual en producción, cualquiera que vea este
# archivo puede firmar tokens válidos como si fuera Administrador. Genera
# el tuyo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="cambia-esto-por-una-llave-de-al-menos-32-caracteres"
JWT_EXPIRES_IN="8h"

PORT=4000
NODE_ENV=development

# Origen permitido para CORS (la URL del frontend en desarrollo)
FRONTEND_ORIGIN="http://localhost:5173"
