// Traducido desde schema_postgres.sql / QueryPAnteones.sql (SQL Server original).
// Modelos en PascalCase (mismo vocabulario que las entidades C# actuales) mapeados
// a tablas/columnas snake_case (idiomático en Postgres) vía @@map / @map.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Supabase (y cualquier Postgres detrás de pgbouncer) necesita una conexión
  // directa aparte para migraciones: el pooler en modo transacción no soporta
  // los prepared statements que usa `prisma migrate`. Ver .env.example.
  directUrl = env("DIRECT_URL")
}

model Rol {
  rolId       Int      @id @default(autoincrement()) @map("rol_id")
  nombre      String   @unique @db.VarChar(50)
  descripcion String?  @db.VarChar(300)
  activo      Boolean  @default(true)
  fechaAlta   DateTime @default(now()) @map("fecha_alta")

  usuarios Usuario[]

  @@map("roles")
}

model TipoTramite {
  tipoTramiteId  Int     @id @default(autoincrement()) @map("tipo_tramite_id")
  clave          String  @unique @db.VarChar(30)
  nombre         String  @db.VarChar(100)
  descripcion    String? @db.VarChar(300)
  retencionAnios Int?    @map("retencion_anios")
  activo         Boolean @default(true)

  permisos Permiso[]

  @@map("tipos_tramite")
}

model TipoLote {
  tipoLoteId  Int     @id @default(autoincrement()) @map("tipo_lote_id")
  nombre      String  @unique @db.VarChar(50)
  descripcion String? @db.VarChar(200)

  lotes Lote[]

  @@map("tipos_lote")
}

model Panteon {
  panteonId       Int     @id @default(autoincrement()) @map("panteon_id")
  nombre          String  @db.VarChar(150)
  clave           String? @unique @db.VarChar(10)
  usaColindancias Boolean @default(false) @map("usa_colindancias")
  direccion       String? @db.VarChar(300)
  activo          Boolean @default(true)

  lotes       Lote[]
  incidencias Incidencia[]

  @@map("panteones")
}

model Usuario {
  usuarioId      Int       @id @default(autoincrement()) @map("usuario_id")
  rolId          Int       @map("rol_id")
  nombreUsuario  String    @unique @map("nombre_usuario") @db.VarChar(100)
  nombreCompleto String    @map("nombre_completo") @db.VarChar(200)
  email          String?   @db.VarChar(150)
  passwordHash   String    @map("password_hash") @db.VarChar(256)
  activo         Boolean   @default(true)
  fechaAlta      DateTime  @default(now()) @map("fecha_alta")
  ultimoAcceso   DateTime? @map("ultimo_acceso")

  rol                    Rol               @relation(fields: [rolId], references: [rolId])
  titulosEmitidos        TituloPropiedad[] @relation("TituloEmitio")
  titulosAprobados       TituloPropiedad[] @relation("TituloAprobo")
  cesionesRegistradas    CesionDerechos[]  @relation("CesionRegistro")
  cesionesAprobadas      CesionDerechos[]  @relation("CesionAprobo")
  permisosRegistrados    Permiso[]         @relation("PermisoRegistro")
  permisosAprobados      Permiso[]         @relation("PermisoAprobo")
  reconocimientos        Reconocimiento[]
  reimpresiones          Reimpresion[]
  bitacoras              Bitacora[]
  incidenciasRegistradas Incidencia[]

  @@map("usuarios")
}

model Persona {
  personaId            Int      @id @default(autoincrement()) @map("persona_id")
  nombreCompleto       String   @map("nombre_completo") @db.VarChar(200)
  curp                 String?  @db.Char(18)
  domicilio            String?  @db.VarChar(300)
  colonia              String?  @db.VarChar(150)
  telefono             String?  @db.VarChar(25)
  correoElectronico    String?  @map("correo_electronico") @db.VarChar(150)
  identificacionTipo   String?  @map("identificacion_tipo") @db.VarChar(50)
  identificacionNumero String?  @map("identificacion_numero") @db.VarChar(50)
  fechaRegistro        DateTime @default(now()) @map("fecha_registro")

  titulos            TituloPropiedad[]
  cesionesCedente    CesionDerechos[]  @relation("Cedente")
  cesionesCesionario CesionDerechos[]  @relation("Cesionario")
  permisos           Permiso[]

  @@map("personas")
}

model Fallecido {
  fallecidoId         Int       @id @default(autoincrement()) @map("fallecido_id")
  nombreCompleto      String    @map("nombre_completo") @db.VarChar(200)
  fechaNacimiento     DateTime? @map("fecha_nacimiento") @db.Date
  fechaFallecimiento  DateTime? @map("fecha_fallecimiento") @db.Date
  actaDefuncionNumero String?   @map("acta_defuncion_numero") @db.VarChar(100)
  actaDefuncionFolio  String?   @map("acta_defuncion_folio") @db.VarChar(100)
  actaDefuncionFecha  DateTime? @map("acta_defuncion_fecha") @db.Date
  causaFallecimiento  String?   @map("causa_fallecimiento") @db.VarChar(300)
  esNoReclamado       Boolean   @default(false) @map("es_no_reclamado")
  descripcionHallazgo String?   @map("descripcion_hallazgo") @db.VarChar(500)
  numeroCaso          String?   @map("numero_caso") @db.VarChar(60)
  posibleNombre       String?   @map("posible_nombre") @db.VarChar(200)
  horaFallecimiento   DateTime? @map("hora_fallecimiento") @db.Time(0)
  fechaLevantamiento  DateTime? @map("fecha_levantamiento") @db.Date
  lugarLevantamiento  String?   @map("lugar_levantamiento") @db.VarChar(250)
  ministerioPublico   String?   @map("ministerio_publico") @db.VarChar(200)
  reconocido          Boolean   @default(false)
  fechaRegistro       DateTime  @default(now()) @map("fecha_registro")

  permisos        Permiso[]
  reconocimientos Reconocimiento[]

  @@map("fallecidos")
}

model Lote {
  loteId           Int      @id @default(autoincrement()) @map("lote_id")
  panteonId        Int      @map("panteon_id")
  tipoLoteId       Int      @map("tipo_lote_id")
  numeroManzana    String   @map("numero_manzana") @db.VarChar(20)
  numeroLote       String   @map("numero_lote") @db.VarChar(20)
  seccion          String?  @db.VarChar(50)
  zona             String?  @db.VarChar(50)
  dimensiones      String?  @db.VarChar(100)
  comprobantePago  String?  @map("comprobante_pago") @db.VarChar(200)
  colindanciaNorte String?  @map("colindancia_norte") @db.VarChar(200)
  colindanciaSur   String?  @map("colindancia_sur") @db.VarChar(200)
  colindanciaEste  String?  @map("colindancia_este") @db.VarChar(200)
  colindanciaOeste String?  @map("colindancia_oeste") @db.VarChar(200)
  claveLegado      String?  @map("clave_legado") @db.VarChar(50)
  estado           String   @default("DISPONIBLE") @db.VarChar(20)
  esFosaComun      Boolean  @default(false) @map("es_fosa_comun")
  fechaRegistro    DateTime @default(now()) @map("fecha_registro")

  panteon         Panteon           @relation(fields: [panteonId], references: [panteonId])
  tipoLote        TipoLote          @relation(fields: [tipoLoteId], references: [tipoLoteId])
  titulos         TituloPropiedad[]
  cesiones        CesionDerechos[]
  permisos        Permiso[]
  reconocimientos Reconocimiento[]
  incidencias     Incidencia[]

  @@unique([panteonId, seccion, numeroManzana, numeroLote], name: "uq_lotes_ubicacion")
  @@map("lotes")
}

model TituloPropiedad {
  tituloId        Int       @id @default(autoincrement()) @map("titulo_id")
  loteId          Int       @map("lote_id")
  titularId       Int       @map("titular_id")
  folio           String    @unique @db.VarChar(50)
  fechaEmision    DateTime? @map("fecha_emision") @db.Date
  usuarioEmitioId Int       @map("usuario_emitio_id")
  usuarioAproboId Int?      @map("usuario_aprobo_id")
  fechaAprobacion DateTime? @map("fecha_aprobacion")
  estado          String    @default("VIGENTE") @db.VarChar(20)
  estadoEntrega   String    @default("PENDIENTE_ENTREGA") @map("estado_entrega") @db.VarChar(30)
  fechaEntrega    DateTime? @map("fecha_entrega") @db.Date
  rutaDocumento   String?   @map("ruta_documento") @db.VarChar(500)
  fechaCreacion   DateTime  @default(now()) @map("fecha_creacion")

  lote          Lote             @relation(fields: [loteId], references: [loteId])
  titular       Persona          @relation(fields: [titularId], references: [personaId])
  usuarioEmitio Usuario          @relation("TituloEmitio", fields: [usuarioEmitioId], references: [usuarioId])
  usuarioAprobo Usuario?         @relation("TituloAprobo", fields: [usuarioAproboId], references: [usuarioId])
  cesiones      CesionDerechos[]
  reimpresiones Reimpresion[]

  @@map("titulos_propiedad")
}

model CesionDerechos {
  cesionId          Int       @id @default(autoincrement()) @map("cesion_id")
  tituloId          Int       @map("titulo_id")
  loteId            Int       @map("lote_id")
  cedenteId         Int       @map("cedente_id")
  cesionarioId      Int       @map("cesionario_id")
  folio             String    @unique @db.VarChar(50)
  fechaCesion       DateTime  @map("fecha_cesion") @db.Date
  usuarioRegistroId Int       @map("usuario_registro_id")
  usuarioAproboId   Int?      @map("usuario_aprobo_id")
  fechaAprobacion   DateTime? @map("fecha_aprobacion")
  estado            String    @default("VIGENTE") @db.VarChar(20)
  rutaDocumento     String?   @map("ruta_documento") @db.VarChar(500)
  fechaCreacion     DateTime  @default(now()) @map("fecha_creacion")

  titulo          TituloPropiedad @relation(fields: [tituloId], references: [tituloId])
  lote            Lote            @relation(fields: [loteId], references: [loteId])
  cedente         Persona         @relation("Cedente", fields: [cedenteId], references: [personaId])
  cesionario      Persona         @relation("Cesionario", fields: [cesionarioId], references: [personaId])
  usuarioRegistro Usuario         @relation("CesionRegistro", fields: [usuarioRegistroId], references: [usuarioId])
  usuarioAprobo   Usuario?        @relation("CesionAprobo", fields: [usuarioAproboId], references: [usuarioId])
  reimpresiones   Reimpresion[]

  @@map("cesion_derechos")
}

model Permiso {
  permisoId           Int       @id @default(autoincrement()) @map("permiso_id")
  tipoTramiteId       Int       @map("tipo_tramite_id")
  loteId              Int?      @map("lote_id")
  solicitanteId       Int       @map("solicitante_id")
  fallecidoId         Int?      @map("fallecido_id")
  folio               String    @unique @db.VarChar(50)
  fechaSolicitud      DateTime? @map("fecha_solicitud") @db.Date
  fechaEmision        DateTime? @map("fecha_emision")
  usuarioRegistroId   Int       @map("usuario_registro_id")
  usuarioAproboId     Int?      @map("usuario_aprobo_id")
  estado              String    @default("PENDIENTE") @db.VarChar(20)
  motivoExhumacion    String?   @map("motivo_exhumacion") @db.VarChar(300)
  destinoRestos       String?   @map("destino_restos") @db.VarChar(300)
  ubicacionDeposito   String?   @map("ubicacion_deposito") @db.VarChar(300)
  tipoObra            String?   @map("tipo_obra") @db.VarChar(100)
  descripcionObra     String?   @map("descripcion_obra") @db.VarChar(500)
  esDonacion          Boolean   @default(false) @map("es_donacion")
  numeroRecibo        String?   @map("numero_recibo") @db.VarChar(50)
  funeraria           String?   @db.VarChar(150)
  instanciaSolicita   String?   @map("instancia_solicita") @db.VarChar(250)
  rutaDocumento       String?   @map("ruta_documento") @db.VarChar(500)
  // Panteones antiguos donde nunca se registró un título de propiedad: el
  // lote existe (o se crea al vuelo) pero se autoriza el trámite sin exigirlo,
  // dejando aquí la constancia de que se hizo esa excepción.
  sinTituloRegistrado Boolean   @default(false) @map("sin_titulo_registrado")
  fechaCreacion       DateTime  @default(now()) @map("fecha_creacion")

  tipoTramite     TipoTramite      @relation(fields: [tipoTramiteId], references: [tipoTramiteId])
  lote            Lote?            @relation(fields: [loteId], references: [loteId])
  solicitante     Persona          @relation(fields: [solicitanteId], references: [personaId])
  fallecido       Fallecido?       @relation(fields: [fallecidoId], references: [fallecidoId])
  usuarioRegistro Usuario          @relation("PermisoRegistro", fields: [usuarioRegistroId], references: [usuarioId])
  usuarioAprobo   Usuario?         @relation("PermisoAprobo", fields: [usuarioAproboId], references: [usuarioId])
  reconocimientos Reconocimiento[]
  reimpresiones   Reimpresion[]

  @@map("permisos")
}

model Reconocimiento {
  reconocimientoId    Int       @id @default(autoincrement()) @map("reconocimiento_id")
  fallecidoId         Int       @map("fallecido_id")
  loteId              Int?      @map("lote_id")
  nombreAnterior      String    @map("nombre_anterior") @db.VarChar(200)
  nombreIdentificado  String    @map("nombre_identificado") @db.VarChar(200)
  fechaReconocimiento DateTime? @map("fecha_reconocimiento") @db.Date
  medioIdentificacion String?   @map("medio_identificacion") @db.VarChar(300)
  instanciaSolicita   String?   @map("instancia_solicita") @db.VarChar(250)
  numeroActaDefuncion String?   @map("numero_acta_defuncion") @db.VarChar(50)
  ministerioPublico   String?   @map("ministerio_publico") @db.VarChar(200)
  observaciones       String?   @db.VarChar(600)
  permisoExhumacionId Int?      @map("permiso_exhumacion_id")
  usuarioRegistroId   Int?      @map("usuario_registro_id")
  fechaRegistro       DateTime  @default(now()) @map("fecha_registro") @db.Timestamp(0)

  fallecido         Fallecido @relation(fields: [fallecidoId], references: [fallecidoId])
  lote              Lote?     @relation(fields: [loteId], references: [loteId])
  permisoExhumacion Permiso?  @relation(fields: [permisoExhumacionId], references: [permisoId])
  usuarioRegistro   Usuario?  @relation(fields: [usuarioRegistroId], references: [usuarioId])

  @@index([fallecidoId], name: "ix_reconocimientos_fallecido")
  @@index([fechaReconocimiento], name: "ix_reconocimientos_fecha")
  @@map("reconocimientos")
}

model Reimpresion {
  reimpresionId    Int      @id @default(autoincrement()) @map("reimpresion_id")
  permisoId        Int?     @map("permiso_id")
  tituloId         Int?     @map("titulo_id")
  cesionId         Int?     @map("cesion_id")
  usuarioId        Int      @map("usuario_id")
  fechaReimpresion DateTime @default(now()) @map("fecha_reimpresion")
  motivo           String   @db.VarChar(300)
  rutaDocumento    String?  @map("ruta_documento") @db.VarChar(500)

  permiso Permiso?         @relation(fields: [permisoId], references: [permisoId])
  titulo  TituloPropiedad? @relation(fields: [tituloId], references: [tituloId])
  cesion  CesionDerechos?  @relation(fields: [cesionId], references: [cesionId])
  usuario Usuario          @relation(fields: [usuarioId], references: [usuarioId])

  @@map("reimpresiones")
}

model Bitacora {
  bitacoraId  BigInt   @id @default(autoincrement()) @map("bitacora_id")
  usuarioId   Int?     @map("usuario_id")
  accion      String   @db.VarChar(50)
  tabla       String?  @db.VarChar(100)
  registroId  Int?     @map("registro_id")
  descripcion String?  @db.VarChar(500)
  ipAcceso    String?  @map("ip_acceso") @db.VarChar(50)
  fechaHora   DateTime @default(now()) @map("fecha_hora")

  usuario Usuario? @relation(fields: [usuarioId], references: [usuarioId])

  @@map("bitacoras")
}

model Incidencia {
  incidenciaId      Int       @id @default(autoincrement()) @map("incidencia_id")
  panteonId         Int       @map("panteon_id")
  loteId            Int?      @map("lote_id")
  seccion           String?   @db.VarChar(100)
  numeroManzana     String?   @map("numero_manzana") @db.VarChar(50)
  numeroLote        String?   @map("numero_lote") @db.VarChar(50)
  tipo              String    @db.VarChar(60)
  descripcion       String    @db.VarChar(1000)
  fechaIncidencia   DateTime  @map("fecha_incidencia") @db.Date
  reportadoPor      String?   @map("reportado_por") @db.VarChar(200)
  estado            String    @default("REPORTADA") @db.VarChar(20)
  fechaAtencion     DateTime? @map("fecha_atencion") @db.Date
  atendidoPor       String?   @map("atendido_por") @db.VarChar(200)
  resolucion        String?   @db.VarChar(1000)
  usuarioRegistroId Int?      @map("usuario_registro_id")
  fechaRegistro     DateTime  @default(now()) @map("fecha_registro") @db.Timestamp(3)

  panteon         Panteon  @relation(fields: [panteonId], references: [panteonId])
  lote            Lote?    @relation(fields: [loteId], references: [loteId])
  usuarioRegistro Usuario? @relation(fields: [usuarioRegistroId], references: [usuarioId])

  @@index([panteonId, fechaIncidencia], name: "ix_incidencias_panteon_fecha")
  @@index([estado], name: "ix_incidencias_estado")
  @@map("incidencias")
}
