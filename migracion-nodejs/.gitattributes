# Los archivos que corren en Linux deben quedar con saltos de línea LF aunque
# se editen en Windows: con CRLF, bash y Docker fallan con errores confusos
# ("bad interpreter", "\r: command not found").
*.sh text eol=lf
Dockerfile text eol=lf
Caddyfile text eol=lf
docker-compose.yml text eol=lf
.dockerignore text eol=lf
